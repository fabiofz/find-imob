# Copie para .streamlit/secrets.toml e preencha com credenciais de um cliente OIDC Google.
# Use como redirect_uri um domínio HTTPS público seu, acessível também pelo celular.
[auth]
redirect_uri = "https://SEU-DOMINIO/oauth2callback"
cookie_secret = "GERE-UM-SEGREDO-ALEATORIO-FORTE"
client_id = "CLIENT_ID_DO_GOOGLE"
client_secret = "CLIENT_SECRET_DO_GOOGLE"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
